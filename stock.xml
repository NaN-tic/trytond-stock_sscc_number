<tryton>
    <data>
        <record model="ir.sequence.type" id="sequence_type_sscc">
            <field name="name">SSCC</field>
        </record>
        <record model="ir.sequence.type-res.group"
            id="sequence_type_sscc_group_admin">
            <field name="sequence_type" ref="sequence_type_sscc"/>
            <field name="group" ref="res.group_admin"/>
        </record>
        <record model="ir.sequence.type-res.group"
            id="sequence_type_sscc_group_stock_admin">
            <field name="sequence_type" ref="sequence_type_sscc"/>
            <field name="group" ref="stock.group_stock_admin"/>
        </record>

        <record model="ir.sequence" id="sequence_sscc">
            <field name="name">SSCC</field>
            <field name="sequence_type" ref="sequence_type_sscc"/>
            <field name="padding" eval="8"/>
        </record>

        <record model="ir.ui.view" id="stock_configuration_view_form">
            <field name="model">stock.configuration</field>
            <field name="inherit" ref="stock.stock_configuration_view_form"/>
            <field name="name">configuration_form</field>
        </record>
        <record model="ir.ui.view" id="move_view_form">
            <field name="model">stock.move</field>
            <field name="inherit" ref="stock.move_view_form"/>
            <field name="name">move_form</field>
        </record>
        <record model="ir.ui.view" id="move_view_tree">
            <field name="model">stock.move</field>
            <field name="inherit" ref="stock.move_view_tree"/>
            <field name="name">move_tree</field>
        </record>
        <record model="ir.ui.view" id="move_view_list_shipment">
            <field name="model">stock.move</field>
            <field name="inherit" ref="stock.move_view_list_shipment"/>
            <field name="name">move_list_shipment</field>
        </record>

        <record model="ir.ui.view" id="pallet_serial_view_tree">
            <field name="model">stock.pallet.serial</field>
            <field name="type">tree</field>
            <field name="name">pallet_serial_tree</field>
        </record>
        <record model="ir.ui.view" id="pallet_serial_view_form">
            <field name="model">stock.pallet.serial</field>
            <field name="type">form</field>
            <field name="name">pallet_serial_form</field>
        </record>

        <record model="ir.model.access" id="access_stock_pallet_serial_default">
            <field name="model">stock.pallet.serial</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_stock_pallet_serial">
            <field name="model">stock.pallet.serial</field>
            <field name="group" ref="stock.group_stock"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="False"/>
        </record>
    </data>
</tryton>
