<tryton>
    <data>
        <record model="ir.sequence.type" id="sequence_type_sscc">
            <field name="name">SSCC</field>
        </record>
        <record model="ir.sequence.type-res.group"
            id="sequence_type_sscc_group_admin">
            <field name="sequence_type" ref="sequence_type_sscc"/>
            <field name="group" ref="res.group_admin"/>
        </record>
        <record model="ir.sequence.type-res.group"
            id="sequence_type_sscc_group_stock_admin">
            <field name="sequence_type" ref="sequence_type_sscc"/>
            <field name="group" ref="stock.group_stock_admin"/>
        </record>

        <record model="ir.sequence" id="sequence_sscc">
            <field name="name">SSCC</field>
            <field name="sequence_type" ref="sequence_type_sscc"/>
            <field name="padding" eval="8"/>
        </record>

        <record model="ir.ui.view" id="stock_configuration_view_form">
            <field name="model">stock.configuration</field>
            <field name="inherit" ref="stock.stock_configuration_view_form"/>
            <field name="name">configuration_form</field>
        </record>
    </data>
</tryton>
